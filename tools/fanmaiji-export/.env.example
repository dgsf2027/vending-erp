# Copy this file to your private runtime directory as .env. Never commit it.
# Select it with FANMAIJI_ENV_FILE=/absolute/private/runtime/.env.
FANMAIJI_BASE_URL=https://fanmaiji.top
FANMAIJI_USER=
FANMAIJI_PASS=

# Optional; direct export.py resolves relative paths from the code directory.
# run_daily.py overrides download and lock paths with absolute runtime paths.
FANMAIJI_DOWNLOAD_DIR=downloads
# run_daily.py captures a separate log for each run; a second file is optional.
FANMAIJI_LOG_FILE=
FANMAIJI_LOG_LEVEL=INFO
FANMAIJI_LOCK_FILE=/tmp/fanmaiji-export.lock
